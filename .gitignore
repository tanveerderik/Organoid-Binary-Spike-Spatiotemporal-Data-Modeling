__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/

# Ad-hoc editor/refactor backups and pre-change snapshot trees. These are local
# restore points, not history -- git already provides that.
*.bak_*
ckpts_pre_v2/
ckpts_pre2Cfix/
ckpts_oldsplit_backup/
reports_pre2Cfix/
reports_oldsplit_backup/
*.log

# Generated sample sets: the mp4s and the per-sample stats/*.json are both
# reproducible from manifest.json + run_config.json (which carry every number
# and the exact arguments), so only those are tracked.
reports/generation_regimes_*/*/videos/
reports/generation_regimes_*/*/stats/

# Seed-variance ablation weights: fully summarised by
# reports/stage4c_seed_deployment.json, not worth 25MB in history.
ckpts/motif_prior_adapt_SEED*.pt

# Stage-2A reconstruction sample tree: 7 mp4 + arrays.npz per test clip (279
# clips, ~36MB). Regenerable from ckpts/vqvae_stage2a_best.pt; the summary
# figures, codebook_debug.* and per-sample results.json stay tracked.
reports/reconstruction_stage2a/*/*/*.mp4
reports/reconstruction_stage2a/*/*/arrays.npz

# external baselines: fitted weights and generated sample trees
ckpts/external_baselines/*.pt
reports/external_baselines/*/*/videos/
reports/external_baselines/*/*/stats/

# Manuscript. The LaTeX source, the ICLR class files and the Overleaf staging
# bundle are drafting material and do not belong in the code history; `paper/`
# is a scratch directory that `tools/make_paper_tables.py` writes into. What the
# paper is built FROM stays tracked: the generators in `tools/`, the JSON in
# `reports/`, and the rendered figures in `reports/paper_figures/`.
paper/
*_paper_skeleton.zip

# Derived caches. Not reports -- these were sitting in reports/ at 117MB with
# no code referencing them at all. Regenerable, so never tracked.
ckpts/cache/
